# Application Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///./payment_recovery.db

# Security & CORS
SECRET_KEY=change_this_in_production_super_secret_key_12345
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Razorpay Integration (Test Mode)
RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=rzp_test_mock_secret_key
RAZORPAY_MODE=test

# LLM Intelligence (Optional / Fallback to Rule-based Diagnosis)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Safety Guardrails
MAX_RETRY_ATTEMPTS=3
DEFAULT_RETRY_DELAY_HOURS=24
